# EcoFold daemon unit. Verified on CachyOS (RTX 5060, driver 620.70.06) on
# 2026-11-14; results in docs/DAEMON_PLAN.md section 6.

[Unit]
Description=EcoFold GPU power daemon
After=nvidia-persistenced.service docker.service
Wants=nvidia-persistenced.service

[Service]
Type=exec
ExecStart=/usr/bin/ecofold-daemon
# Last line of defense: restores the default power limit from a fresh process
# even after SIGKILL, OOM or a hung NVML call.
ExecStopPost=/usr/bin/ecofold-daemon -restore-power-limit
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# NVML only accepts SetPowerManagementLimit from uid 0: a non-root user with
# CAP_SYS_ADMIN (effective and ambient) still gets NO_PERMISSION. Run as root
# and keep the capability bounding set and the sandbox below as the limit.
User=root
Group=root
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes

# Holds the pause-ownership marker. "yes" keeps it across stop/start too (a
# package upgrade during a game), not only Restart=; /run is tmpfs, so a
# reboot still clears it.
RuntimeDirectory=ecofold
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidia-uvm rw

[Install]
WantedBy=multi-user.target
